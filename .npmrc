# The dev machine's user and global npmrc point at a corporate proxy registry that lags
# badly (it has served a `latest` several minor versions stale, making installs fail on
# versions that exist publicly), and that setting gets restored automatically, so fixing
# it per-user does not hold. Project config takes precedence, so pin it here.
registry=https://registry.npmjs.org/

# NODE_ENV=production is set in that environment, and npm derives `omit=dev` from it, so a
# plain `npm ci` silently prunes devDependencies and breaks the local test setup. `include`
# is the inverse of `omit` and wins regardless of order, so this restores dev dependencies
# without needing --include=dev on every command. Harmless in CI, which installs them anyway.
include=dev
